# Roshambo bots

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "roshambo_bot",
    srcs = ["roshambo_bot.cc"],
    hdrs = ["roshambo_bot.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    target_compatible_with = select({
        "//open_spiel:build_with_roshambo_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//open_spiel",
        "@roshambo",  # build-cleaner: keep
        "@roshambo//:rsb_bot",
    ],
)

cc_test(
    name = "roshambo_bot_test",
    srcs = ["roshambo_bot_test.cc"],
    deps = [
        ":roshambo_bot",
        "@abseil-cpp//absl/time",
        "//open_spiel",
        "//open_spiel/game_transforms:repeated_game",
        "//open_spiel/games:all_games",  # build-cleaner: keep
        "@roshambo",
    ],
)
