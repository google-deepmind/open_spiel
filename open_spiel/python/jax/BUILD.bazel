load("//bazel/python:pytype.bzl", "pytype_strict_library")
load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:py_test.bzl", "py_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "deep_cfr",
    srcs = ["deep_cfr.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python:policy",
        "//open_spiel/python/algorithms:exploitability",
        "//open_spiel/python/pybind11:pyspiel",
        "//open_spiel/python/utils:lru_cache",
        "@py_deps//chex",
        "@py_deps//flax/nnx:v1",
        "@py_deps//jax",
        "@py_deps//numpy",
        "@py_deps//optax",
    ],
)

py_test(
    name = "deep_cfr_jax_test",
    srcs = ["deep_cfr_jax_test.py"],
    deps = [
        ":deep_cfr",
        "//open_spiel/python:policy",
        "//open_spiel/python/algorithms:exploitability",
        "//open_spiel/python/pybind11:pyspiel",
        "@py_deps//absl/testing:absltest",
        "@py_deps//absl/testing:parameterized",
    ],
)

