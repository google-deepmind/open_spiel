load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:py_test.bzl", "py_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "cards_and_melds",
    srcs = ["cards_and_melds.py"],
    strict_deps = True,
    deps = [
        "@py_deps//chex",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "deadwood",
    srcs = ["deadwood.py"],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":lookup_tables",
        "@py_deps//jax",
    ],
)

py_library(
    name = "dense_cache",
    srcs = ["dense_cache.py"],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":deadwood",
        ":lookup_tables",
        "@py_deps//jax",
    ],
)

py_library(
    name = "dense_cache_game",
    srcs = [
        "dense_cache_game.py",
        "game.py",
    ],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":deadwood",
        ":dense_cache",
        ":layoffs",
        "//open_spiel/python/jax/games:game",
        "//open_spiel/python/jax/games:interop",
        "//open_spiel/python/pybind11:pyspiel",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "gin_rummy",
    srcs = ["__init__.py"],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":dense_cache_game",
        ":layoffs",
    ],
)

py_library(
    name = "layoffs",
    srcs = ["layoffs.py"],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":lookup_tables",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "lookup_tables",
    srcs = ["lookup_tables.py"],
    strict_deps = True,
    deps = ["@py_deps//numpy"],
)

py_library(
    name = "simple_bot",
    srcs = ["simple_bot.py"],
    strict_deps = True,
    deps = [
        ":cards_and_melds",
        ":deadwood",
        ":dense_cache_game",
        "@py_deps//jax",
    ],
)

py_test(
    name = "cached_constants_test",
    srcs = ["cached_constants_test.py"],
    data = ["//open_spiel/python/jax/games:all_files"],
    deps = [
        ":cards_and_melds",
        ":dense_cache_game",
        ":layoffs",
        ":lookup_tables",
        "@py_deps//absl/testing:absltest",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_test(
    name = "deadwood_test",
