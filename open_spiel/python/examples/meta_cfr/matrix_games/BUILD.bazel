pytype_strict_library(
    name = "regret_matching_agent",
    srcs = ["regret_matching_agent.py"],
    deps = [
        "@py_deps//absl/flags",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytype_strict_binary(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":evaluation",
        ":matrix_dataset",
        ":meta_selfplay_agent",
        ":regret_matching_agent",
        "@py_deps//absl:app",
        "@py_deps//absl/flags",
        "@py_deps//numpy",
    ],
)

pytype_strict_library(
    name = "meta_selfplay_agent",
    srcs = ["meta_selfplay_agent.py"],
    deps = [
        ":utils",
        "@py_deps//absl/flags",
        "@py_deps//haiku",
        "@py_deps//jax",
        "@py_deps//numpy",
        "@py_deps//optax",
    ],
)

