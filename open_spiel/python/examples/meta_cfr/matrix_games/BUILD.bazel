"""Build file for meta regret matching."""

load("//bazel/python:pytype.bzl", "pytype_strict_binary", "pytype_strict_library")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//open_spiel:__subpackages__"],
)

pytype_strict_library(
    name = "utils",
    srcs = ["utils.py"],
    deps = [
        "@py_deps//absl/flags",
        "@py_deps//haiku",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytype_strict_library(
    name = "matrix_dataset",
    srcs = ["matrix_dataset.py"],
    deps = [
        "@py_deps//absl/flags",
        "@py_deps//numpy",
    ],
)

pytype_strict_library(
    name = "evaluation",
    srcs = ["evaluation.py"],
    deps = [
        "@py_deps//absl/flags",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

