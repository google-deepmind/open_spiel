        "//open_spiel/python/scale/launch:subprocess_env",
        "@py_deps//absl/testing:absltest",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)

