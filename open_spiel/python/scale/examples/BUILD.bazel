py_test(
    name = "examples_test",
    timeout = "long",
    srcs = ["examples_test.py"],
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    deps = [
        ":play_checkpoints_lib",
        "//open_spiel/python/pybind11:pyspiel",
        "//open_spiel/python/scale:registered",
