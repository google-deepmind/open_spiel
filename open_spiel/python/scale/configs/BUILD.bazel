    name = "mmd_gin_rummy_test",
    timeout = "long",
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    tests = ["tests/mmd_gin_rummy_test.py"],
    deps = [
        "//open_spiel/python/scale:metrics",
        "//open_spiel/python/scale:registered",
