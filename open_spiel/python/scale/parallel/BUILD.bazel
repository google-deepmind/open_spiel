load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "collectives_check",
    srcs = ["collectives_check.py"],
    strict_deps = True,
    deps = [
        "@py_deps//absl/logging",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "compiles",
    srcs = ["compiles.py"],
    strict_deps = True,
    deps = ["@py_deps//jax"],
)

py_library(
    name = "data_parallel",
    srcs = ["data_parallel.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/ckpt:artifact",
        "//open_spiel/python/scale/core:x64",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "parallel",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "probe_arena",
    testonly = True,
    srcs = ["tests/probe_arena.py"],
    strict_deps = True,
    deps = [
        ":compiles",
        ":data_parallel",
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/core:frameworks",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:kuhn",
        "//open_spiel/python/scale/envs/leduc",
        "//open_spiel/python/scale/testing:fixtures",
        "//open_spiel/python/scale/testing:multidevice",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "probe_ckpt",
    testonly = True,
    srcs = ["tests/probe_ckpt.py"],
    strict_deps = True,
    deps = [
        ":data_parallel",
        "//open_spiel/python/scale:train_lib",
        "//open_spiel/python/scale/ckpt:artifact",
        "//open_spiel/python/scale/ckpt:run_state",
        "//open_spiel/python/scale/core:frameworks",
        "//open_spiel/python/scale/league:commit",
        "//open_spiel/python/scale/league:config_common",
        "//open_spiel/python/scale/learners:pg",
        "//open_spiel/python/scale/testing:multidevice",
        "@py_deps//etils/epath",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "probe_learner",
    testonly = True,
    srcs = ["tests/probe_learner.py"],
    strict_deps = True,
    deps = [
        ":compiles",
        ":data_parallel",
        "//open_spiel/python/scale:train_lib",
        "//open_spiel/python/scale/configs:az_connect_four",
        "//open_spiel/python/scale/configs:recipes",
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/core:frameworks",
        "//open_spiel/python/scale/core:schedules",
        "//open_spiel/python/scale/eval:exploitability",
        "//open_spiel/python/scale/league:config_common",
        "//open_spiel/python/scale/learners:az",
        "//open_spiel/python/scale/learners:bc",
        "//open_spiel/python/scale/learners:losses",
        "//open_spiel/python/scale/learners:pg",
        "//open_spiel/python/scale/testing:multidevice",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "arena_shard_map_test",
    timeout = "long",
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    tests = ["tests/arena_shard_map_test.py"],
    deps = [
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/launch:subprocess_env",
        "//open_spiel/python/scale/testing:multidevice",
    ],
)

pytest_test(
    name = "collectives_check_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/collectives_check_test.py"],
    deps = [
        ":collectives_check",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/launch:subprocess_env",
        "@py_deps//jax",
    ],
)

pytest_test(
    name = "data_parallel_test",
    timeout = "long",
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    tests = ["tests/data_parallel_test.py"],
    deps = [
        ":compiles",
        ":data_parallel",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/launch:subprocess_env",
        "//open_spiel/python/scale/league:config_common",
        "//open_spiel/python/scale/learners:pg",
        "//open_spiel/python/scale/testing:multidevice",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytest_test(
    name = "sharded_ckpt_test",
    timeout = "long",
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    tests = ["tests/sharded_ckpt_test.py"],
    deps = [
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/launch:subprocess_env",
        "//open_spiel/python/scale/testing:multidevice",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)
