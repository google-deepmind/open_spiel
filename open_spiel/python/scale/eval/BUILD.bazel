load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "eval",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "exploitability",
    srcs = ["exploitability.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:game_tree",
        "//open_spiel/python/scale/core:sequence",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "heldout",
    srcs = ["heldout.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/core:x64",
        "//open_spiel/python/scale/learners:losses",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "match",
    srcs = ["match.py"],
    strict_deps = True,
    deps = [
        ":payoff",
        "//open_spiel/python/scale/core:arena_engine",
        "//open_spiel/python/scale/core:deadline",
        "//open_spiel/python/scale/core:rng",
