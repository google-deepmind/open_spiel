    strict_deps = True,
    deps = ["@py_deps//numpy"],
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "exploitability_test",
    timeout = "long",
    data = ["//open_spiel/python/scale:all_files"],
    tags = [
        "manual",
    ],
    tests = ["tests/exploitability_test.py"],
    deps = [
        ":exploitability",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:kuhn",
        "//open_spiel/python/scale/envs/leduc",
        "//open_spiel/python/scale/policies:tabular",
        "//open_spiel/python/scale/policies:uniform",
        "//open_spiel/python/scale/testing:fixtures",
        "//open_spiel/python/scale/testing:populations",
        "@py_deps//jax",
        "@py_deps//numpy",
