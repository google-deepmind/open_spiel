load("//bazel/python:py_library.bzl", "py_library")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "belief",
    srcs = ["belief.py"],
    strict_deps = True,
    deps = [
        ":gin",
        "//open_spiel/python/jax/games/gin_rummy:cards_and_melds",
        "//open_spiel/python/jax/games/gin_rummy:deadwood",
        "//open_spiel/python/scale/belief:registry",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/core:x64",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "endgame",
    srcs = ["endgame.py"],
    strict_deps = True,
    deps = [
        ":gin",
        ":rule_bot",
        "//open_spiel/python/jax/games/gin_rummy:cards_and_melds",
        "//open_spiel/python/jax/games/gin_rummy:deadwood",
        "//open_spiel/python/jax/games/gin_rummy:layoffs",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/policies:fixed_action",
        "//open_spiel/python/scale/policies:registry",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "gin",
    srcs = ["__init__.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/jax/games/gin_rummy:cards_and_melds",
        "//open_spiel/python/jax/games/gin_rummy:deadwood",
        "//open_spiel/python/jax/games/gin_rummy:dense_cache",
        "//open_spiel/python/jax/games/gin_rummy:dense_cache_game",
        "//open_spiel/python/scale/envs:jax_game_env",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "reference_eval",
    srcs = ["reference_eval.py"],
    strict_deps = True,
    deps = [
        ":gin",
        ":rule_bot",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:registry",
        "//open_spiel/python/scale/eval:match",
        "//open_spiel/python/scale/eval:registry",
        "//open_spiel/python/scale/policies:routed",
    ],
)

py_library(
    name = "rule_bot",
    srcs = ["rule_bot.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/jax/games/gin_rummy:cards_and_melds",
        "//open_spiel/python/jax/games/gin_rummy:simple_bot",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/policies:fixed_action",
        "//open_spiel/python/scale/policies:registry",
        "@py_deps//jax",
    ],
)

py_library(
    name = "search",
    srcs = ["search.py"],
    strict_deps = True,
    deps = [
        ":belief",
        "//open_spiel/python/scale/ckpt:artifact",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:registry",
        "//open_spiel/python/scale/league:slot_factories",
        "//open_spiel/python/scale/policies:routed",
        "//open_spiel/python/scale/policies:search",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)
