load("//bazel/python:py_library.bzl", "py_library")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "hearts_telemetry",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "moon",
    srcs = ["moon.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/jax/games:hearts",
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:hearts",
        "//open_spiel/python/scale/league:config_common",
        "@py_deps//absl/logging",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)
