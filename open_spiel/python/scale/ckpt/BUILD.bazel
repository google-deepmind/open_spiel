load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "artifact",
    srcs = ["artifact.py"],
    strict_deps = True,
    deps = [
        ":codecs",
        ":formats",
        ":provenance",
        ":records",
        "//open_spiel/python/scale:plugins",
        "//open_spiel/python/scale/core:frameworks",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/policies:registry",
        "@py_deps//etils/epath",
    ],
)

py_library(
    name = "ckpt",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "codecs",
    srcs = ["codecs.py"],
    strict_deps = True,
    deps = [
        ":snapshot",
        "//open_spiel/python/scale:plugins",
        "//open_spiel/python/scale/core:frameworks",
        "@py_deps//etils/epath",
        "@py_deps//jax",
        "@py_deps//numpy",
        "@py_deps//orbax/checkpoint",
    ],
)

py_library(
    name = "formats",
    srcs = ["formats.py"],
    strict_deps = True,
    deps = ["//open_spiel/python/scale/core:sequence"],
)

py_library(
    name = "layout",
    srcs = ["layout.py"],
    strict_deps = True,
)

py_library(
    name = "provenance",
    srcs = ["provenance.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale:plugins",
        "@py_deps//absl/logging",
        "@py_deps//jax",
    ],
)

py_library(
    name = "records",
    srcs = ["records.py"],
    strict_deps = True,
)

py_library(
    name = "run_state",
    srcs = ["run_state.py"],
    strict_deps = True,
    deps = [
        ":artifact",
        ":codecs",
        ":layout",
        ":records",
        ":snapshot",
        "//open_spiel/python/scale/core:x64",
        "@py_deps//etils/epath",
    ],
)

py_library(
    name = "sharded_probe",
    testonly = True,
    srcs = ["tests/sharded_probe.py"],
    strict_deps = True,
    deps = [
        ":artifact",
        "//open_spiel/python/scale/core:frameworks",
        "//open_spiel/python/scale/testing:fixtures",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "snapshot",
    srcs = ["snapshot.py"],
    strict_deps = True,
    deps = ["@py_deps//numpy"],
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "artifact_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/artifact_test.py"],
    deps = [
        ":artifact",
        ":codecs",
        ":formats",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/launch:subprocess_env",
        "//open_spiel/python/scale/policies:tabular",
        "//open_spiel/python/scale/policies:uniform",
        "//open_spiel/python/scale/testing:fixtures",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytest_test(
    name = "load_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/load_test.py"],
    deps = [
        ":artifact",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/networks:helpers",
        "//open_spiel/python/scale/networks:policy",
        "//open_spiel/python/scale/policies:tabular",
        "//open_spiel/python/scale/testing:fixtures",
        "@py_deps//etils/epath",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytest_test(
    name = "params_digest_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/params_digest_test.py"],
    deps = [
        ":artifact",
        ":codecs",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/core:numpy_policies",
        "//open_spiel/python/scale/policies:tabular",
        "//open_spiel/python/scale/policies:uniform",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

pytest_test(
    name = "records_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/records_test.py"],
    deps = [
        ":records",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
    ],
)

pytest_test(
    name = "verify_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/verify_test.py"],
    deps = [
        ":run_state",
        ":snapshot",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "//open_spiel/python/scale/league:league_fixtures",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)
