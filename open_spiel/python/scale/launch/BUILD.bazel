load("//bazel/python:py_binary.bzl", "py_binary")
load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "backend",
    srcs = [
        "backend.py",
        "config.py",
        "gcp.py",
        "local.py",
        "preemption.py",
    ],
    data = [
        "examples/gcp_cpu.yaml",
        "examples/gcp_gpu.yaml",
    ],
    strict_deps = True,
    deps = [
        ":hardware",
        ":storage",
        ":subprocess_env",
        "//open_spiel/python/scale:deps",
        "//open_spiel/python/scale:plugins",
        "@py_deps//absl/logging",
        "@py_deps//yaml",
    ],
)

py_library(
    name = "cloud_lib",
    srcs = ["cloud.py"],
    data = ["cloud_example.yaml"],
    strict_deps = True,
    deps = [
        ":preflight",
        ":subprocess_env",
        "//open_spiel/python/scale:deps",
        "//open_spiel/python/scale:plugins",
        "@py_deps//yaml",
    ],
)

py_library(
    name = "compile_cache",
    srcs = ["compile_cache.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/ckpt:artifact",
        "@py_deps//absl/logging",
        "@py_deps//etils/epath",
        "@py_deps//jax",
    ],
)

py_library(
    name = "hardware",
    srcs = ["hardware.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale:metrics",
        "//open_spiel/python/scale:plugins",
        "//open_spiel/python/scale/ckpt:artifact",
        "@py_deps//absl/logging",
        "@py_deps//etils/epath",
        "@py_deps//jax",
    ],
)

py_library(
    name = "launch",
    srcs = ["__init__.py"],
    data = ["cloud_example.yaml"],
    strict_deps = True,
)

py_library(
    name = "preflight",
    srcs = ["preflight.py"],
    strict_deps = True,
    deps = [
        ":subprocess_env",
        "//open_spiel/python/scale:deps",
        "//open_spiel/python/scale/envs:registry",
        "@py_deps//absl/logging",
    ],
)

py_library(
    name = "run_lib",
    srcs = ["run.py"],
    strict_deps = True,
    deps = [
        ":backend",
        ":preflight",
        ":supervisor",
        "//open_spiel/python/scale:plugins",
        "//open_spiel/python/scale/core:frameworks",
        "@py_deps//absl/logging",
    ],
)

py_library(
    name = "storage",
    srcs = ["storage.py"],
    strict_deps = True,
    deps = ["@py_deps//absl/logging"],
)

py_library(
    name = "subprocess_env",
    srcs = ["subprocess_env.py"],
    strict_deps = True,
)

py_library(
    name = "supervisor",
    srcs = ["supervisor.py"],
    strict_deps = True,
    deps = [
        ":backend",
        "@py_deps//absl/logging",
    ],
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "cloud_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/cloud_test.py"],
    deps = [
        ":cloud_lib",
        ":subprocess_env",
        "//open_spiel/python/scale:plugins",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
    ],
)

