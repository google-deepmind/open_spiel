# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)

py_binary(
    name = "cloud",
    srcs = ["cloud.py"],
    strict_deps = True,
    deps = [
        ":cloud_lib",
        "//open_spiel/python/scale:runtime",
    ],
)

py_binary(
    name = "run",
    srcs = ["run.py"],
    strict_deps = True,
    deps = [
        ":run_lib",
        "//open_spiel/python/scale:runtime",
    ],
)
