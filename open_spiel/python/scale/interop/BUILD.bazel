load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "host",
    srcs = ["host.py"],
    strict_deps = True,
    deps = [
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "interop",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "host_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/host_test.py"],
    deps = [
        ":host",
        "//open_spiel/python/scale:registered",
        "//open_spiel/python/scale:tests_conftest",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

# Every file of the package below this folder (the tests' data).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//open_spiel/python/scale:__subpackages__"],
)
