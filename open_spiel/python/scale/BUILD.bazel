load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "deps",
    srcs = ["deps.py"],
    strict_deps = True,
)

py_library(
    name = "metrics",
    srcs = ["metrics.py"],
    strict_deps = True,
    deps = [
