load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:pytest.bzl", "pytest_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "dagger",
    srcs = ["dagger.py"],
    strict_deps = True,
    deps = [
        ":targets",
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/core:decide",
        "//open_spiel/python/scale/core:schedules",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/core:x64",
        "//open_spiel/python/scale/policies:opening",
        "//open_spiel/python/scale/policies:routed",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "deals",
    srcs = ["deals.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:arena",
        "//open_spiel/python/scale/core:arena_engine",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:registry",
        "@py_deps//etils/epath",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "decisions",
    srcs = ["decisions.py"],
