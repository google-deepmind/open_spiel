py_library(
    name = "shards",
    srcs = ["shards.py"],
    strict_deps = True,
    deps = [
        ":deals",
        "//open_spiel/python/scale/ckpt:artifact",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/core:x64",
        "@py_deps//etils/epath",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "sources",
    srcs = ["__init__.py"],
    strict_deps = True,
)

py_library(
    name = "targets",
    srcs = ["targets.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:advantages",
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/policies:operator_vocab",
        "@py_deps//jax",
    ],
)

py_library(
    name = "tests_init",
    testonly = True,
    srcs = ["tests/__init__.py"],
    strict_deps = True,
)

pytest_test(
    name = "bridge_deals_test",
    data = ["//open_spiel/python/scale:all_files"],
    tests = ["tests/bridge_deals_test.py"],
    deps = [
        ":deals",
        ":shards",
        "//open_spiel/python/scale:registered",
