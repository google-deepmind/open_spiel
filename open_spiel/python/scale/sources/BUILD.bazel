    deps = [
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/policies:routed",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "helpers",
    testonly = True,
    srcs = ["tests/helpers.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:sequence",
        "//open_spiel/python/scale/envs:kuhn",
        "//open_spiel/python/scale/policies:tabular",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "replay",
    srcs = ["replay.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/scale/core:sequence",
        "@py_deps//jax",
        "@py_deps//numpy",
    ],
