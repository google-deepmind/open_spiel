    deps = [
        "//open_spiel/python/algorithms:get_all_states",
        "//open_spiel/python/algorithms:policy_aggregator",
        "//open_spiel/python/algorithms:policy_aggregator_joint",
        "//open_spiel/python/egt:alpharank",
        "//open_spiel/python/egt:utils",
        "@py_deps//numpy",
