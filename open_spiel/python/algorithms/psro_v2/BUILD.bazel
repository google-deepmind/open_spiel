load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:py_test.bzl", "py_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "rl_oracle",
    srcs = ["rl_oracle.py"],
    strict_deps = True,
    deps = [
        ":optimization_oracle",
        ":utils",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "psro_v2",
    srcs = ["psro_v2.py"],
    strict_deps = True,
    deps = [
        ":abstract_meta_trainer",
        ":strategy_selectors",
        ":utils",
        "//open_spiel/python:policy",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "strategy_selectors",
    srcs = ["strategy_selectors.py"],
    strict_deps = True,
    deps = ["@py_deps//numpy"],
)

py_library(
    name = "abstract_meta_trainer",
    srcs = ["abstract_meta_trainer.py"],
    strict_deps = True,
    deps = [
        ":meta_strategies",
        ":strategy_selectors",
        ":utils",
        "@py_deps//numpy",
    ],
)

py_library(
    name = "meta_strategies",
    srcs = ["meta_strategies.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python/algorithms:lp_solver",
        "//open_spiel/python/algorithms:projected_replicator_dynamics",
        "//open_spiel/python/algorithms:regret_matching",
