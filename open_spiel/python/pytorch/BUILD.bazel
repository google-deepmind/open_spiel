load("//bazel/python:py_library.bzl", "py_library")
load("//bazel/python:py_test.bzl", "py_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

py_library(
    name = "rcfr",
    srcs = ["rcfr.py"],
    strict_deps = True,
    deps = [
        ":deep_cfr",
        "@py_deps//numpy",
        "@py_deps//torch:pytorch",
    ],
)

py_library(
    name = "dqn",
    srcs = ["dqn.py"],
    strict_deps = True,
    deps = [
        "//open_spiel/python:rl_agent",
        "//open_spiel/python:rl_environment",
        "@py_deps//numpy",
        "@py_deps//torch:pytorch",
        "@py_deps//tree",
    ],
)

py_library(
    name = "boltzmann_dqn",
    srcs = ["boltzmann_dqn.py"],
    strict_deps = True,
    deps = [
        ":dqn",
        "@py_deps//numpy",
        "@py_deps//torch:pytorch",
    ],
)

