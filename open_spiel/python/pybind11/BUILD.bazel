load("//bazel/python:pybind.bzl", "pybind_extension", "pybind_library")

# Python bindings for open spiel

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

pybind_library(
    name = "pybind11",
    hdrs = ["pybind11.h"],
    deps = [
        "@abseil-cpp//absl/types:optional",
        "@nlohmann_json//:json",
        "//open_spiel",
    ],
)

pybind_library(
    name = "bots",
    srcs = ["bots.cc"],
    hdrs = ["bots.h"],
    copts = select({
        "//open_spiel:build_with_roshambo_enabled": [
            "-DOPEN_SPIEL_BUILD_WITH_ROSHAMBO",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":pybind11",
        "//open_spiel",
        "//open_spiel:all_games",
        "//open_spiel/algorithms:evaluate_bots",
        "//open_spiel/algorithms:is_mcts",
        "//open_spiel/algorithms:mcts",
        "//open_spiel/bots/gin_rummy:simple_gin_rummy_bot",
        "//open_spiel/game_transforms:normal_form_extensive_game",
        "//open_spiel/game_transforms:turn_based_simultaneous_game",
        "//open_spiel/games/efg_game",
        "//open_spiel/games/efg_game:efg_game_data",
    ] + select({
        "//open_spiel:build_with_acpc_enabled": [
            "//open_spiel/games/universal_poker",
        ],
        "//conditions:default": [],
    }) + select({
        "//open_spiel:build_with_roshambo_enabled": [
            "//open_spiel/bots/roshambo:roshambo_bot",
        ],
        "//conditions:default": [],
    }) + select({
        "//open_spiel:build_with_xinxin_enabled": [
            "//open_spiel/bots/xinxin:xinxin_bot",
        ],
        "//conditions:default": [],
    }) + select({
        # The UCI bot uses POSIX process APIs; make_uci_bot is not bound there.
        "@platforms//os:windows": [],
        "//conditions:default": ["//open_spiel/bots/uci:uci_bot"],
    }),
)

