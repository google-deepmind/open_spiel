load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "catch_the_hidden_evader",
    srcs = ["catch_the_hidden_evader.cc"],
    hdrs = [
        "catch_the_hidden_evader.h",
        "catch_the_hidden_evader_maps.h",
    ],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "@abseil-cpp//absl/types:span",
        "@nlohmann_json//:json",
        "//open_spiel",
        "//open_spiel/utils:file",
    ],
    alwayslink = 1,
)

cc_test(
    name = "catch_the_hidden_evader_test",
    srcs = ["catch_the_hidden_evader_test.cc"],
    deps = [
        ":catch_the_hidden_evader",
        "@abseil-cpp//absl/strings",
        "@nlohmann_json//:json",
        "//open_spiel",
        "//open_spiel:basic_tests",
    ],
)
