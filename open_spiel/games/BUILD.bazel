# Description:
#   Spiel games targets.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

# Core games that we will use as a first step to major changes.
cc_library(
    name = "games",
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "//open_spiel/games/kuhn_poker",
        "//open_spiel/games/matrix_games",
        "//open_spiel/games/tic_tac_toe",
    ],
)

