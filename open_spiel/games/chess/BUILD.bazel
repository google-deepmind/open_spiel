# Description:
#   Chess implementation details.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "chess",
    srcs = [
        "chess.cc",
        "chess960_starting_positions.cc",
    ],
    hdrs = ["chess.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        ":chess_board",
        ":chess_common",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "@abseil-cpp//absl/types:span",
        "//open_spiel",
    ],
    alwayslink = 1,
)

cc_test(
    name = "chess_test",
    srcs = ["chess_test.cc"],
    deps = [
        ":chess",
        ":chess_board",
        "@abseil-cpp//absl/random:distributions",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "@abseil-cpp//absl/types:span",
        "//open_spiel",
        "//open_spiel:basic_tests",
    ],
)

cc_library(
    name = "chess_board",
    srcs = ["chess_board.cc"],
    hdrs = ["chess_board.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        ":chess_common",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "//open_spiel",
    ],
)

cc_library(
    name = "chess_common",
    srcs = ["chess_common.cc"],
    hdrs = ["chess_common.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "@abseil-cpp//absl/random:distributions",
        "//open_spiel",
    ],
)
