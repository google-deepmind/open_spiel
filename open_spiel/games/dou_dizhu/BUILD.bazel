load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "dou_dizhu",
    srcs = [
        "dou_dizhu.cc",
        "dou_dizhu_utils.cc",
    ],
    hdrs = [
        "dou_dizhu.h",
        "dou_dizhu_utils.h",
    ],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:optional",
        "//open_spiel",
    ],
    alwayslink = 1,
)

cc_test(
    name = "dou_dizhu_test",
    srcs = ["dou_dizhu_test.cc"],
    deps = [
        ":dou_dizhu",
        "@abseil-cpp//absl/algorithm:container",
        "//open_spiel",
        "//open_spiel:basic_tests",
    ],
)

cc_test(
    name = "dou_dizhu_utils_test",
    srcs = ["dou_dizhu_utils_test.cc"],
    deps = [
        ":dou_dizhu",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/types:optional",
        "//open_spiel",
    ],
)
