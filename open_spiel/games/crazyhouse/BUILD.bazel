# Description:
#   crazyhouse implementation details.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "crazyhouse",
    srcs = ["crazyhouse.cc"],
    hdrs = ["crazyhouse.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        ":crazyhouse_board",
        ":crazyhouse_common",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "@abseil-cpp//absl/types:span",
        "//open_spiel",
        "//open_spiel/games/chess",
    ],
    alwayslink = 1,
)

cc_test(
    name = "crazyhouse_test",
    srcs = ["crazyhouse_test.cc"],
    deps = [
        ":crazyhouse",
        ":crazyhouse_board",
        "@abseil-cpp//absl/random:distributions",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "@abseil-cpp//absl/types:span",
        "//open_spiel",
        "//open_spiel:basic_tests",
    ],
)

cc_library(
    name = "crazyhouse_board",
    srcs = ["crazyhouse_board.cc"],
    hdrs = ["crazyhouse_board.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        ":crazyhouse_common",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:optional",
        "//open_spiel",
    ],
)

cc_library(
    name = "crazyhouse_common",
    srcs = ["crazyhouse_common.cc"],
    hdrs = ["crazyhouse_common.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "@abseil-cpp//absl/random:distributions",
        "@abseil-cpp//absl/strings",
        "//open_spiel",
    ],
)
