load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_applicable_licenses = ["//open_spiel:license"],
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

exports_files(["CMakeLists.txt"])

cc_library(
    name = "einstein_wurfelt_nicht",
    srcs = ["einstein_wurfelt_nicht.cc"],
    hdrs = ["einstein_wurfelt_nicht.h"],
    copts = ["-fexceptions"],
    features = ["-use_header_modules"],
    deps = [
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "//open_spiel",
        "//open_spiel/games/hex",
        "//open_spiel/utils:combinatorics",
    ],
    alwayslink = 1,
)

cc_test(
    name = "einstein_wurfelt_nicht_test",
    srcs = ["einstein_wurfelt_nicht_test.cc"],
    deps = [
        ":einstein_wurfelt_nicht",
        "//open_spiel",
        "//open_spiel:basic_tests",
    ],
)
