"""Repository rule creating `@py_deps`, the Python dependency label tree.

OpenSpiel BUILD files refer to Python packages as `@py_deps//<package>[:<target>]`.
For every entry of `PY_DEPS` this rule writes a `py_library` that forwards to the
matching pip packages of the `@open_spiel_pip` hub. Labels missing from the table fail
with "no such package" / "no such target", so unknown dependencies never get
silently dropped.
"""

load(":py_deps_table.bzl", "PY_DEPS")

def _split(key):
    """Splits `pkg[:target]` into (pkg, target); target defaults to the basename."""
    if ":" in key:
        pkg, target = key.split(":")
    else:
        pkg, target = key, key.split("/")[-1]
    return pkg, target

def _py_deps_repo_impl(rctx):
    py_library_bzl = str(Label("@rules_python//python:py_library.bzl"))
    targets_by_pkg = {}
    for key, pip_names in PY_DEPS.items():
        pkg, target = _split(key)
        deps = [str(Label("@open_spiel_pip//" + pip_name)) for pip_name in pip_names]
        targets_by_pkg.setdefault(pkg, []).append((target, deps))

    for pkg, targets in targets_by_pkg.items():
        lines = [
            "# Generated by py_deps.bzl. Do not edit.",
            'load("{}", "py_library")'.format(py_library_bzl),
            "",
            'package(default_visibility = ["//visibility:public"])',
        ]
        for target, deps in sorted(targets):
            lines.append("")
            lines.append("py_library(")
            lines.append('    name = "{}",'.format(target))
            lines.append("    deps = {},".format(json.encode(deps)))
            lines.append(")")
        rctx.file(pkg + "/BUILD.bazel", "\n".join(lines) + "\n")
    rctx.file("BUILD.bazel", "")

py_deps_repo = repository_rule(
    implementation = _py_deps_repo_impl,
    doc = "Creates @py_deps from PY_DEPS in py_deps_table.bzl.",
)
