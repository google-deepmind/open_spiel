"""Repository rule creating `@py_deps`, the Python dependency label tree.

OpenSpiel BUILD files refer to Python packages as `@py_deps//<package>[:<target>]`.
This rule reads every BUILD file under `open_spiel/` (minus `.bazelignore`d
directories) and writes a `py_library` for each such label, forwarding to the
pip packages of the `@open_spiel_pip` hub that `py_deps_table.bzl` and
`requirements_lock.txt` resolve it to. A label that resolves to no locked pip
package becomes a target whose analysis fails with a message naming the label
and what to add, so unknown dependencies never get silently dropped. Labels
used outside those BUILD files fail with "no such package" / "no such target"
unless `PY_DEPS` lists them.
"""

load(":py_deps_table.bzl", "LOCAL_PY_DEPS", "PY_DEPS", "PY_PACKAGES")

_PREFIX = "\"@py_deps//"
_BUILD_FILE_NAMES = ["BUILD", "BUILD.bazel"]

# Upper bound on the number of directories walked (Starlark has no while).
_MAX_DIRS = 100000

_MISSING_BZL = """# Generated by py_deps.bzl. Do not edit.

def _missing_py_dep_impl(ctx):
    fail(ctx.attr.message)

missing_py_dep = rule(
    implementation = _missing_py_dep_impl,
    attrs = {"message": attr.string()},
)
"""

def _split(key):
    """Splits `pkg[:target]` into (pkg, target); target defaults to the basename."""
    if ":" in key:
        pkg, target = key.split(":")
    else:
        pkg, target = key, key.split("/")[-1]
    return pkg, target

def normalize(pip_name):
    """Returns the rules_python hub name of a pip distribution or package."""
    return pip_name.lower().replace("-", "_").replace(".", "_")

def _locked_packages(text):
    """Returns the normalized names pinned in a requirements lock file."""
    names = {}
    for line in text.splitlines():
        if line and (line[0].isalpha() or line[0].isdigit()) and "==" in line:
            names[normalize(line.split("==")[0].split("[")[0].strip())] = True
    return names

def resolve(key, locked):
    """Returns the pip packages (or the local target) for `key`, or None.

    Args:
      key: a label `<package>[:<target>]` under @py_deps.
      locked: dict whose keys are the normalized pip names in the lock.

    Returns:
      ("pip", [names]) or ("local", label), or None if `key` resolves to
      nothing.
    """
    if key in PY_DEPS:
        return ("pip", PY_DEPS[key])
    top = key.split(":")[0].split("/")[0]
    if top in LOCAL_PY_DEPS:
        return ("local", LOCAL_PY_DEPS[top])
    if top in PY_PACKAGES:
        return ("pip", PY_PACKAGES[top])
    if normalize(top) in locked:
        return ("pip", [normalize(top)])
    return None

def _labels_in(text):
    """Returns the `<package>[:<target>]` of every "@py_deps//..." in `text`."""
    keys = []
    for chunk in text.split(_PREFIX)[1:]:
        key = chunk.split("\"")[0]
        if key and key not in keys:
            keys.append(key)
    return keys

def _ignored_dirs(rctx, root):
    """Returns the absolute paths .bazelignore lists, as strings."""
    ignore_file = root.get_child(".bazelignore")
    if not ignore_file.exists:
        return {}
    ignored = {}
    for line in rctx.read(ignore_file).splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            ignored[str(root) + "/" + line.rstrip("/")] = True
    return ignored

def _requested_labels(rctx, root):
    """Returns the @py_deps labels named in the BUILD files under open_spiel/."""
    ignored = _ignored_dirs(rctx, root)
    keys = {}
    stack = [root.get_child("open_spiel")]
    for _ in range(_MAX_DIRS):
        if not stack:
            break
        directory = stack.pop()
        for child in directory.readdir():
            if child.is_dir:
                if not child.basename.startswith(".") and str(child) not in ignored:
                    stack.append(child)
            elif child.basename in _BUILD_FILE_NAMES:
                for key in _labels_in(rctx.read(child)):
                    keys[key] = True
    if stack:
        fail("py_deps: more than {} directories under {}".format(_MAX_DIRS, root))
    return keys.keys()

def _missing_message(key):
    top = key.split(":")[0].split("/")[0]
    return (
        "@py_deps//{key} (a Python dependency) resolves to no pip package: " +
        "'{pip}' is not in bazel/python/requirements_lock.txt. Add the pip " +
        "package to bazel/python/requirements.in and run " +
        "bazel/python/update_requirements_lock.sh; if its pip name differs " +
        "from '{top}', also map '{top}' in PY_PACKAGES of " +
        "bazel/python/py_deps_table.bzl."
    ).format(key = key, pip = normalize(top), top = top)

def _py_deps_repo_impl(rctx):
    py_library_bzl = str(Label("@rules_python//python:py_library.bzl"))
    lock = rctx.path(Label("//bazel/python:requirements_lock.txt"))
    root = lock.dirname.dirname.dirname
    locked = _locked_packages(rctx.read(lock))
    keys = list(PY_DEPS.keys())
    for key in sorted(_requested_labels(rctx, root)):
        if key not in keys:
            keys.append(key)

    targets_by_pkg = {}
    for key in keys:
        pkg, target = _split(key)
        resolved = resolve(key, locked)
        if resolved == None:
            target_text = 'missing_py_dep(\n    name = "{}",\n    message = {},\n)'.format(
                target,
                json.encode(_missing_message(key)),
            )
        else:
            kind, value = resolved
            if kind == "local":
                deps = [str(Label(value))]
            else:
                deps = [str(Label("@open_spiel_pip//" + name)) for name in value]
            target_text = 'py_library(\n    name = "{}",\n    deps = {},\n)'.format(
                target,
                json.encode(deps),
            )
        targets_by_pkg.setdefault(pkg, {})[target] = target_text

    for pkg, targets in targets_by_pkg.items():
        lines = [
            "# Generated by py_deps.bzl. Do not edit.",
            'load("{}", "py_library")'.format(py_library_bzl),
            'load("//:missing.bzl", "missing_py_dep")',
            "",
            'package(default_visibility = ["//visibility:public"])',
        ]
        for target in sorted(targets):
            lines.append("")
            lines.append(targets[target])
        rctx.file(pkg + "/BUILD.bazel", "\n".join(lines) + "\n")
    rctx.file("missing.bzl", _MISSING_BZL)
    rctx.file("BUILD.bazel", "")

py_deps_repo = repository_rule(
    implementation = _py_deps_repo_impl,
    doc = "Creates @py_deps from the BUILD files, py_deps_table.bzl and the lock.",
)
