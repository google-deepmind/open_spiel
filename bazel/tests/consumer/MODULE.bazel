"""Example Bazel project depending on OpenSpiel; see bazel/README.md.

Built by the bazel_consumer CI job, against the OpenSpiel checkout it is in.
"""

module(name = "open_spiel_consumer")

bazel_dep(name = "open_spiel")
local_path_override(
    module_name = "open_spiel",
    path = "../../..",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_python", version = "2.4.4")
